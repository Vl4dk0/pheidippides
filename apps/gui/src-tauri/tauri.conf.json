{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pheidippides",
  "mainBinaryName": "pheidippides",
  "version": "0.3.0",
  "identifier": "sk.pheidippides.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pheidippides",
        "width": 1180,
        "height": 800,
        "minWidth": 480,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBQzM5OTg2MDE0NzMzNzgKUldSNE0wY0JocG5EaXJYemFzUXVyeDJsYS9CZXY5TnFmZTlBSlU3NlFFQ3IrRWlHN3o0VUJjUDUK",
      "endpoints": [
        "https://github.com/Vl4dk0/pheidippides/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
